# Datos de la app registrada en el User Pool de Cognito
VITE_COGNITO_AUTHORITY=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# Local: http://localhost:5173/callback   |   Vercel: https://tu-app.vercel.app/callback
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/callback
VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_COGNITO_DOMAIN=https://xxxxxxxxxxx.auth.us-east-1.amazoncognito.com

# Endpoint del API Gateway (todas las llamadas protegidas pasan por aqui)
VITE_API_BASE_URL=https://tu-api-id.execute-api.us-east-1.amazonaws.com

# Registro (asignar-grupo): siempre por el API Gateway. ms-usuarios exige el header x-api-secret,
# que solo el Gateway inyecta, asi que llamar a la EC2 directo (tambien en local) responde 401.
# Requiere la ruta publica POST /api/auth/asignar-grupo en el Gateway (sin authorizer, con el mapeo del secreto).
VITE_USUARIOS_SERVICE_URL=https://tu-api-id.execute-api.us-east-1.amazonaws.com
